<!-- ═══════════ COMMENT ÇA MARCHE ═══════════ -->
<section id="process" class="section">
  <div class="container">
    <div class="label">Comment ça marche</div>
    <h2>De votre premier message<br>à votre site en ligne —<br><span class="orange">voici chaque étape.</span></h2>
    <p class="process-sub">Pas de surprise, pas de flou. Vous savez exactement ce qui se passe — et ce que vous avez à faire à chaque moment.</p>

    <div class="process-timeline">
      <div class="process-timeline-line"></div>
      <div class="process-timeline-fill"></div>

      <!-- ÉTAPE 01 -->
      <div class="proc-step anim">
        <div class="proc-node">01</div>
        <div>
          <div class="proc-head">
            <p class="proc-title">Discussion gratuite</p>
            <span class="proc-badge badge-wa">WhatsApp</span>
          </div>
          <p class="proc-sub">Sous 2h · Gratuit · Sans engagement</p>
          <div class="proc-roles">
            <div class="proc-role proc-role-vous">
              <span class="proc-role-label">Vous</span>
              <p class="proc-role-desc">Décrivez votre restaurant en quelques minutes</p>
            </div>
            <div class="proc-role proc-role-moi">
              <span class="proc-role-label">Moi</span>
              <p class="proc-role-desc">J'analyse vos besoins et vous propose la formule adaptée à votre restaurant</p>
            </div>
          </div>
          <!-- Mini discussion WhatsApp -->
          <div class="wa-chat-cap">Exemple de première discussion</div>
          <div class="wa-chat reveal" id="wa-chat" aria-label="Exemple de première discussion sur WhatsApp">
            <div class="wa-chat-head">
              <span class="wa-av"><img src="/img/founder.webp" alt=""></span>
              <div><b>Nour Digital</b><small class="wa-status">en ligne</small></div>
            </div>
            <div class="wa-chat-body">
              <div class="msg me">Bonjour Nour 👋 J'ai un maquis à Ouaga 2000. Je voudrais apparaître sur Google.<span class="t">14:02 <span class="tk">✓✓</span></span></div>
              <div class="msg them">Bonjour ! Avec plaisir 🙂 Vous servez sur place, en livraison, ou les deux ?<span class="t">14:09</span></div>
              <div class="msg me">Les deux ! Et je veux que les clients voient le menu.<span class="t">14:10 <span class="tk">✓✓</span></span></div>
              <div class="msg them">Parfait 👌 Je vous conseille le <b>Site Starter</b> : menu, Google Maps et bouton WhatsApp. Je vous envoie un exemple 👇<span class="t">14:12</span></div>
              <div class="wa-typing"><i></i><i></i><i></i></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ÉTAPE 02 -->
      <div class="proc-step anim">
        <div class="proc-node">02</div>
        <div>
          <div class="proc-head">
            <p class="proc-title">Accord & infos</p>
            <span class="proc-badge badge-pmt">Avance 50 %</span>
          </div>
          <p class="proc-sub">Orange Money · Moov Money · Espèces</p>
          <div class="proc-roles">
            <div class="proc-role proc-role-vous">
              <span class="proc-role-label">Vous</span>
              <p class="proc-role-desc">Envoyez vos photos & textes, versez l'avance de 50 %</p>
            </div>
            <div class="proc-role proc-role-moi">
              <span class="proc-role-label">Moi</span>
              <p class="proc-role-desc">Je crée votre maquette sur mesure à partir de vos contenus</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ÉTAPE 03 -->
      <div class="proc-step anim">
        <div class="proc-node">03</div>
        <div>
          <div class="proc-head">
            <p class="proc-title">Maquette & validation</p>
            <span class="proc-badge badge-time">J+2 à J+4</span>
          </div>
          <p class="proc-sub">Refaite gratuitement si non validée</p>
          <div class="proc-roles">
            <div class="proc-role proc-role-vous">
              <span class="proc-role-label">Vous</span>
              <p class="proc-role-desc">Validez le design ou demandez un ajustement</p>
            </div>
            <div class="proc-role proc-role-moi">
              <span class="proc-role-label">Moi</span>
              <p class="proc-role-desc">Je code votre site complet une fois le design validé</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ÉTAPE 04 -->
      <div class="proc-step anim">
        <div class="proc-node">04</div>
        <div>
          <div class="proc-head">
            <p class="proc-title">Livraison & transfert</p>
            <span class="proc-badge badge-live">En ligne</span>
          </div>
          <p class="proc-sub">Accès complets · Le site vous appartient</p>
          <div class="proc-roles">
            <div class="proc-role proc-role-vous">
              <span class="proc-role-label">Vous</span>
              <p class="proc-role-desc">Vérifiez le site en ligne et réglez le solde (50 %)</p>
            </div>
            <div class="proc-role proc-role-moi">
              <span class="proc-role-label">Moi</span>
              <p class="proc-role-desc">Je transfère tous les accès — le site vous appartient entièrement</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

